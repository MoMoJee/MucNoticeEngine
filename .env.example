# 复制为 .env 并填入。程序启动时会自动读取当前目录的 .env。
# 优先级：默认值 < config.toml < .env < 真实环境变量。.env 已在 .gitignore 中。

MUC_USERNAME=
MUC_PASSWORD=

MNE_DATA_DIR=data
MNE_DB_PATH=data/muc_notice.db
MNE_POLL_INTERVAL_MINUTES=240
MNE_REQUEST_TIMEOUT_SECONDS=20
MNE_MAX_CONCURRENT_REQUESTS=5
MNE_RSS_MAX_ITEMS=150
MNE_PORTAL_PAGE_LIMIT=3

MNE_ARCHIVE_ENABLE=true
MNE_ARCHIVE_DIR=data/archive
MNE_ARCHIVE_WORKERS=2
MNE_ARCHIVE_MAX_FILE_MB=50
MNE_ARCHIVE_MAX_PER_NOTICE=50
MNE_ARCHIVE_ENQUEUE_LIMIT_PER_POLL=50
MNE_ARCHIVE_WINDOW_DAYS=90
MNE_ARCHIVE_FLOOR_DATE=2026-08-31
MNE_ARCHIVE_TOTAL_LIMIT_GB=64
MNE_BACKFILL_PUSH=false

MNE_API_HOST=127.0.0.1
MNE_API_PORT=8080
MNE_API_TOKEN=
